NODE_ENV=development
PORT=4000

# Local: mongodb://127.0.0.1:27017/ecomm-store  |  Atlas: mongodb+srv://<user>:<password>@<cluster>/ecomm-store
MONGO_URI=mongodb://127.0.0.1:27017/ecomm-store

# Frontend origin allowed by CORS (no trailing slash)
CLIENT_URL=http://localhost:5173

# Generate each with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# The two secrets must be different.
ACCESS_TOKEN_SECRET=replace-with-a-long-random-string
REFRESH_TOKEN_SECRET=replace-with-a-different-long-random-string

# Optional, defaults to 15m
ACCESS_TOKEN_EXPIRES_IN=15m
